# 7. DIAGNÓSTICO DE AUTOCORRELACIÓN ESPACIAL (TEST DE MORAN REVISADO Y SEGURO)
cat("\n--- TEST DE MORAN (AUTOCORRELACIÓN ESPACIAL PARA EL MODELO HURDLE) ---\n")

# Extraemos los residuos simulados del modelo completo original 
# (Aquí las dimensiones coinciden al 100% con los datos del modelo ajustado)
residuos_completos <- simulateResiduals(fittedModel = mod_hurdle_tmb, n = 250)

# Seleccionamos la submuestra de 2,000 datos usando la función nativa de DHARMa.
# Al pasar la fórmula espacial, DHARMa alinea las coordenadas y limpia los NAs de forma automática.
set.seed(123)
sub_indices <- sample(1:length(residuos_completos$scaledResiduals), 2000)

residuos_sub_dharma <- recalculateResiduals(residuos_completos, sel = sub_indices)

# Ejecutar el Test de Moran formal indicando las variables espaciales exactas
testSpatialAutocorrelation(
  simulationOutput = residuos_sub_dharma, 
  x = data$Longitud[sub_indices], 
  y = data$Latitud[sub_indices]
)

