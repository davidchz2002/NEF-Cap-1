# 5. GLM BINOMIAL NEGATIVACON CON DATOS CUADRÁTICOS
############################################################

# 1. Ajustar el modelo completo con las formas no lineales detectadas en el AED
# EXPLICACIÓN DE LAS VARIABLES SEGÚN EL AED:
# - TmesFrio: Se incluye el término cuadrático I(TmesFrio^2) debido a la "joroba" u óptimo
#   térmico del AED (la riqueza sube con el calor, pero cae en fríos extremos).
# - DistCosta: Se incluye I(DistCosta^2) debido a la caída asintótica en picado observada,
#   donde la riqueza se desploma al alejarse del litoral y luego se estabiliza.
# - NOTA DE SELECCIÓN: Estamos metiendo estas variables de forma lineal y cuadrática a la vez. 
#   Si el término cuadrático no resulta significativo en el summary, deberá ser eliminado 
#   en el paso posterior de selección de variables (así como cualquier variable irrelevante).

mod_nb2 <- glm.nb(
  Riqueza ~ TmesFrio + I(TmesFrio^2) + PmesSeco + pH + HIImed + DistCosta + I(DistCosta^2) + LongRios, 
  data = data
)

# Inspección inicial de coeficientes para planificar la selección de variables
summary(mod_nb2)

# 1. ¿POR QUÉ NO SE PUEDE ELIMINAR LA VARIABLE LINEAL SI DEJAMOS LA CUADRÁTICA?
# - En estadística paramétrica, si un término de orden superior (I(variable^2)) es 
#   significativo, su término de orden inferior (variable lineal) DEBE permanecer 
#   en el modelo de manera obligatoria por el Principio de Jerarquía.
# - Si borrásemos la variable lineal, estaríamos forzando al modelo a asumir que el 
#   punto de inflexión de la curva (el pico de la joroba o el fondo de la U) ocurre 
#   exactamente en el valor 0 de nuestra variable estandarizada. Eso destruye el 
#   ajuste estadístico, sesga los residuos y altera artificialmente los p-valores.

# 2. Diagnóstico de Autocorrelación Espacial (Test de Moran)
# Seleccionamos una submuestra aleatoria para evitar que la matriz de 20k filas colapse la RAM
set.seed(123)
sub <- data[sample(1:nrow(data), 2000), ]

# Extraemos los residuos de este nuevo modelo con curvas para ver si el espacio queda limpio
residuos_sub <- residuals(mod_nb2, type = "pearson")[as.numeric(rownames(sub))]
matriz_pesos <- 1 / as.matrix(dist(cbind(sub$Longitud, sub$Latitud)))
diag(matriz_pesos) <- 0

# Ejecutar el Test de Moran formal
# Si p.value > 0.05, confirmamos que tras incluir las curvas, los residuos son independientes.
cat("\n--- TEST DE MORAN (AUTOCORRELACIÓN ESPACIAL PARA MOD_NB2) ---\n")
Moran.I(residuos_sub, matriz_pesos)


# 3. Diagnóstico de Exceso de Ceros (Inflación de Ceros)
# Comprobamos si mod_nb2 sigue manteniendo la capacidad de replicar tu 70% de ceros
# ahora que le hemos incorporado la complejidad de las formas cuadráticas.
cat("\n--- COMPROBACIÓN DE INFLACIÓN DE CEROS PARA MOD_NB2 ---\n")
check_zeroinflation(mod_nb2)

# Ejecutar la selección automática hacia atrás (Backward) basada en AIC
cat("--- Ejecutando la selección de variables... ---\n")
mod_nb2_optimo <- stepAIC(mod_nb2, direction = "backward")

# Mostrar el resultado del modelo final simplificado
cat("\n--- MODELO ÓPTIMO SELECCIONADO ---\n")
summary(mod_nb2_optimo)


# Ejecutar la comprobación con el tipo de residuo correcto para la Binomial Negativa
performance::check_model(mod_nb2_optimo, 
                         check = c("homogeneity", "overdispersion", "outliers"),
                         residual_type = "normal")

# Test de sobredispersión

gof(mod_nb2_optimo)

